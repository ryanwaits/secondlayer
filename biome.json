{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignore": [
			"**/dist/**",
			"**/node_modules/**",
			"**/.next/**",
			"**/build/**",
			"packages/subgraphs/test/fixtures/blockdata-8100000-8100100.json",
			"apps/web/src/generated/**",
			".vercel/**",
			".claude/**",
			"skills/secondlayer/dash/template/**",
			"skills/secondlayer/dash/recipes/**",
			"skills/secondlayer/examples/**",
			"docs/mocks/**"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": {
				"noAutofocus": "off"
			},
			"nursery": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"zod/v4": "Import from \"zod\" — the /v4 compat subpath is not guaranteed past zod 4."
						}
					}
				}
			}
		}
	},
	"organizeImports": {
		"enabled": true
	},
	"overrides": [
		{
			"include": ["**/*.test.ts", "**/test/**/*.ts"],
			"linter": {
				"rules": {
					"performance": {
						"noDelete": "off"
					}
				}
			}
		}
	]
}
