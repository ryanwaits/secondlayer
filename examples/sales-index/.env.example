# Your database. Secondlayer never sees it — bring Neon, Supabase, RDS, your
# platform's managed Postgres, or a container on the same box.
DATABASE_URL=postgres://user:pass@host:5432/sales

# Optional. Loopback reads need no key. Writes / published binds use INSTANCE_TOKEN.
SL_API_URL=http://127.0.0.1:3800
SL_API_KEY=

# Port the health server binds. Most platforms inject this themselves.
PORT=8080
