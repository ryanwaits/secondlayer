# Dependencies
node_modules/
bun.lockb

# Build output
dist/
*.tsbuildinfo
.next/

# Generated files (for examples)
examples/generated/

# repomix snapshot — regenerated on demand, never commit
repo.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local databases
*.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage reports (repo root only — do not ignore src/coverage/)
/coverage/
.nyc_output/

# Environment variables. Ignore the whole family — `.env`, `.env.local`,
# `.env.bak`, `.env.save`, `.env.prod` — so a backup or copy of a real env file
# can never be committed with live credentials. The negation re-admits the
# tracked `*.example` templates and MUST stay after the wildcard to take effect.
.env*
!.env*.example

# `sl project use` writes the active project binding here. Per-checkout local
# state — never useful in version control.
.secondlayer/

# Temporary files
*.tmp
*.temp
tmp/
# Docs are tracked, including internal working docs (audits, plans, mocks,
# specs, runbooks, charters) under docs/internal/.

# Config files (users should create their own)
secondlayer.config.ts
secondlayer.config.js
secondlayer.config.mjs
.vercel
plans/

# Claude Code local state
.claude/
!/.claude/
/.claude/*
!/.claude/sprints/
!/.claude/sprints/current-sprint.md
!/.claude/skills/
!/.claude/skills/**

.scaffold-test-*
packages/subgraphs/test/fixtures/

# Cadence (local tooling artifacts)
.cadence/

# CSS Studio MCP regenerates this skill on connect each session; the canonical
# tracked copy lives at .claude/skills/studio/. Ignore the duplicate so it never
# re-enters git (see commit b2f2be7c which moved it out of .agents/).
.agents/skills/studio/
.openpkg-spec.json
cassettes/

# Local bb visual artifacts
.bb-artifacts/
