# Caddy config — single platform host post 2026-05-14 shared-rip.
#
# Backend routing:
#   api.{BASE_DOMAIN}   →  api:3800   (`/hooks/slack*` → agent:3900)
{
	email {$CADDY_ACME_EMAIL:ryan.waits@gmail.com}
}

api.{$BASE_DOMAIN:secondlayer.tools} {
	header -Server
	header X-Content-Type-Options nosniff

	# Access log → rotated file on the caddy_logs volume. `remote_ip` is the real
	# client IP (Linux iptables DNAT preserves source through the published port),
	# so this is the source of truth for unique-IP / top-path analytics until the
	# Loki+Alloy log plane (Phase 1) ships these lines centrally. JSON so it greps
	# with `jq` and ingests into Loki unchanged.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	handle /hooks/slack* {
		reverse_proxy agent:3900
	}
	handle {
		# Load-balance across all `api` replicas. `dynamic a` re-resolves the
		# service name against Docker's embedded DNS (127.0.0.11) every refresh,
		# so replicas added/removed during a rolling deploy enter/leave the pool
		# automatically. Passive failover (fail_duration) drops a replica that's
		# mid-recreate and retries the next within lb_try_duration → no 502.
		reverse_proxy {
			dynamic a {
				name api
				port 3800
				refresh 2s
			}
			lb_policy round_robin
			fail_duration 10s
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}

# Public canonical archive — read-only static tree served from the snapshot
# export dir: `latest.json` (the one mutable pointer, short TTL) plus
# digest-addressed snapshot manifests and partitions (immutable forever).
# The CLI resolves `verify/bootstrap --against https://archive.../latest.json`.
archive.{$BASE_DOMAIN:secondlayer.tools} {
	header -Server
	header X-Content-Type-Options nosniff

	root * /srv/archive
	file_server

	@latest path /latest.json
	header @latest Cache-Control "public, max-age=60"

	@immutable not path /latest.json
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}

# Self-hosted console. The app self-gates (CONSOLE_TOKEN cookie) and serves
# everything under /console (Next basePath); the bare host redirects there.
console.{$BASE_DOMAIN:secondlayer.tools} {
	header -Server
	header X-Content-Type-Options nosniff

	redir / /console 308
	reverse_proxy console:3801
}
