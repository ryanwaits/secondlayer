# Isolated feeder project. Copy to docker/feeder/.env on the host that will
# run compose. Do not put this file in docker/ (prod COMPOSE_FILE).
# Never commit the live copy.

COMPOSE_PROJECT_NAME=secondlayer-feeder

# --- node-server (docker-compose.yml) ---
# COMPOSE_FILE=docker-compose.yml
STACKS_FEEDER_DATA_DIR=/data/stacks-feeder
APP_SERVER_IP=65.21.135.94
# Copy from node-server docker/node-server/.env into Config.toml password.
# BITCOIN_RPC_PASSWORD=

# --- app-server (docker-compose.scratch.yml) ---
# COMPOSE_FILE=docker-compose.scratch.yml
POSTGRES_FEEDER_DATA_DIR=/opt/secondlayer/data/postgres-feeder
POSTGRES_USER=secondlayer
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=secondlayer_feeder
# Copy DEPLOY_IMAGE_* from app-server docker/.env (same indexer/api images).
DEPLOY_IMAGE_OWNER=ryanwaits
DEPLOY_IMAGE_TAG=latest
TIP_FOLLOWER_ENABLED=true
STACKS_NODE_RPC_URL=http://37.27.171.220:21443
