# Isolated feeder project on the cloud VM. Copy to docker/feeder/.env on the
# host that will run compose. Never commit the live copy.

COMPOSE_PROJECT_NAME=secondlayer-feeder

STACKS_FEEDER_DATA_DIR=/data/feeder/stacks
POSTGRES_FEEDER_DATA_DIR=/data/feeder/postgres
POSTGRES_USER=secondlayer
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=secondlayer_feeder

# Local feat image built on this box. Do not use prod GHCR :latest (no 0131).
INDEXER_IMAGE=secondlayer-indexer:feat-eval-hook

TIP_FOLLOWER_ENABLED=true
OBSERVER_JOURNAL_ENABLED=false
STACKS_NODE_RPC_URL=http://stacks-feeder:20443
