# Project
COMPOSE_PROJECT_NAME=secondlayer

# PostgreSQL
POSTGRES_USER=secondlayer
POSTGRES_PASSWORD=secondlayer
POSTGRES_DB=secondlayer
POSTGRES_PORT=5432

# Service ports
API_PORT=3800
INDEXER_PORT=3700

# Required on the archive box; decoder and API must match; do not use `sk-sl_`
# prefix (generate with `sl-int_`). OSS compose should omit this and use
# INSTANCE_TOKEN. Empty env no longer falls back to a committed secret.
STREAMS_INTERNAL_API_KEY=CHANGE_ME

# Shared rate-limit store. Defaults to the compose `redis` service. Unset for
# process-local limits (single API instance only). The API fails OPEN — a Redis
# outage stops enforcing limits rather than 503-ing requests.
REDIS_URL=redis://redis:6379

# Logging
LOG_LEVEL=info

# Email (for magic link auth)
RESEND_API_KEY=
EMAIL_FROM=secondlayer <noreply@secondlayer.tools>
# Where "Talk to us" messages are emailed (Reply-To is the sender). Empty: stored only.
CONTACT_NOTIFY_EMAIL=

# PostHog project token for the API's funnel events (sign-in, account, key,
# first read). Empty: no events. Hosted sets the web app's project token.
POSTHOG_PROJECT_TOKEN=

# Web push for the installed phone app. Generate once with
# `bunx web-push generate-vapid-keys`. Unset: push is off, nothing breaks.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URL or mailto: that push services can reach you at.
VAPID_SUBJECT=

# Networks
NETWORKS=mainnet

# Stacks node RPC. Enables subgraph handler chain reads
# (`ctx.client.contract(...).read`) and transaction proofs. Point it at the
# Nakamoto node you already run — no additional service. Unset → those two
# features report a clean error; everything else is unaffected.
STACKS_NODE_RPC_URL=
# marf-witness serve sidecar next to the node (read-only proofs for /v1/proofs); unset = proofs disabled
PROOF_SIDECAR_URL=

# Tip follower (re-syncs from the own stacks-node + local DB when the node goes silent)
TIP_FOLLOWER_ENABLED=true
# TIP_FOLLOWER_TIMEOUT=60
# TIP_FOLLOWER_MAX_BLOCKS=10

# Stripe billing (platform mode only)
# - Restricted key in sandbox first, live later.
# - WEBHOOK_SECRET is printed by `stripe listen --forward-to localhost:3800/api/billing/stripe`
#   for local dev; live value comes from the Stripe dashboard webhook config.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

