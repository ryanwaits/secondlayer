# Copy to .env, fill, chmod 600.
POSTGRES_USER=secondlayer
POSTGRES_PASSWORD=
POSTGRES_DB=secondlayer
# Tunnel address Postgres listens on (WireGuard wg0 on this host).
POSTGRES_BIND=10.77.0.1
DATA_DIR=/data

# WAL-G → R2. Private bucket, prefix unique to this host.
WALG_S3_PREFIX=s3://secondlayer-db-backups/pg-db-server
WALG_R2_ACCESS_KEY_ID=
WALG_R2_SECRET_ACCESS_KEY=
WALG_R2_ENDPOINT=
