[Unit]
Description=Secondlayer canonical archive coverage audit with Slack alerting
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/opt/secondlayer/docker/.env
ExecStart=/opt/secondlayer/docker/scripts/canonical-audit-alert.sh
StandardOutput=append:/var/log/secondlayer-canonical-audit.log
StandardError=append:/var/log/secondlayer-canonical-audit.log
