[Unit]
Description=Secondlayer archive status refresh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/opt/secondlayer/docker/.env
ExecStart=/opt/secondlayer/docker/scripts/archive-status.sh
StandardOutput=append:/var/log/secondlayer-archive-status.log
StandardError=append:/var/log/secondlayer-archive-status.log
