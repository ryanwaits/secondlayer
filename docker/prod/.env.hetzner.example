# Hetzner AX52 Deployment Configuration
# Copy to .env and fill in values

POSTGRES_USER=secondlayer
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=secondlayer

# Base domain. Caddy serves `api.{BASE_DOMAIN}` + wildcard `*.{BASE_DOMAIN}`
# (tenant subdomains). Requires a wildcard A record (`*` and `api` → SERVER_IP).
BASE_DOMAIN=your-domain.example.com
CADDY_ACME_EMAIL=you@your-domain.example.com
SERVER_IP=your.server.ip.here

LOG_LEVEL=info
NETWORKS=mainnet

# Required on the archive box; decoder and API must match; do not use `sk-sl_`
# prefix (generate with `sl-int_`). OSS compose should omit this and use
# INSTANCE_TOKEN. Empty env no longer falls back to a committed secret.
STREAMS_INTERNAL_API_KEY=CHANGE_ME

# ed25519 private key (PKCS8 PEM) for signing Streams responses. When set, the
# API signs every Streams read with X-Signature and serves the public key at
# /public/streams/signing-key. Leave unset to disable signing (no headers).
# Store the PEM as a single line with literal \n between lines, e.g.
#   STREAMS_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4...\n-----END PRIVATE KEY-----\n"
STREAMS_SIGNING_PRIVATE_KEY=

# Storage paths
DATA_DIR=/opt/secondlayer/data

# Tip follower — disable during genesis sync, enable after caught up
TIP_FOLLOWER_ENABLED=true

# Auth (magic link emails)
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=secondlayer <noreply@secondlayer.tools>
# Where "Talk to us" messages are emailed (Reply-To is the sender). Empty: stored only.
CONTACT_NOTIFY_EMAIL=

# PostHog project token for the API's funnel events: the web app's
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN. Empty: no events.
POSTHOG_PROJECT_TOKEN=

# Hetzner Storage Box (offsite backups)
STORAGEBOX_USER=uXXXXXX
STORAGEBOX_HOST=uXXXXXX.your-storagebox.de
STORAGEBOX_PATH=backups
STORAGEBOX_PORT=23

# WAL-G database backups → R2 (point-in-time recovery). See
# docs/internal/runbook/db-backup-restore.md. The sidecars refuse to start
# without their own scoped credential and an encryption key (never the
# STREAMS_BULK_R2_* dump credential). WALG_S3_PREFIX MUST be a SEPARATE PRIVATE
# bucket from the public dumps bucket.
WALG_S3_PREFIX=s3://secondlayer-db-backups/pg-enc
WALG_R2_ACCESS_KEY_ID=          # required: R2 token scoped to the backup bucket
WALG_R2_SECRET_ACCESS_KEY=      # required
# WALG_R2_ENDPOINT=             # optional (else STREAMS_BULK_R2_ENDPOINT): https://<acct>.r2.cloudflarestorage.com
WALG_LIBSODIUM_KEY=             # required: `openssl rand -base64 32`; keep an offsite copy, a lost key means unreadable backups
WALG_RETAIN_FULL=4             # keep last 4 weekly base backups (~1 month)
WALG_BACKUP_INTERVAL_SECS=604800  # weekly base backup; WAL gives second-level PITR regardless

# Health alerting (docker/scripts/health-alert.sh via systemd timer)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX
# Classifier for ops scripts (slack-gate, triage) and the worker's feedback labeller. Provider: jev | kev | clef | rules.
# Unset → jev when AI_GATEWAY_API_KEY is set, else rules (offline; slack-gate fail-opens).
# CLASSIFIER=
# CLASSIFIER_MODEL=            # optional pin; default typesafe-ai/jev | kev-latest | clef
AI_GATEWAY_API_KEY=
# KEV_URL=                     # kev System One server, e.g. http://127.0.0.1:8009
# KEV_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=       # clef on Workers AI
# CLOUDFLARE_API_TOKEN=
NODE_SERVER_URL=http://<node-server-ip>
