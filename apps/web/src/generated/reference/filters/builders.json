		{
			"id": "fromSubgraphSource",
			"path": "fromSubgraphSource",
			"summary": "Rebuilds a canonical filter from a subgraph source object.",
			"description": "Rebuilds a canonical filter from a subgraph source object.\n\nIt is the inverse of `toSubgraphSource`. It powers migration and the\nround-trip property gate: `toSubgraphSource(fromSubgraphSource(f))` must\ndeep-equal `f` for every production subgraph source.",
			"source": {
				"file": "packages/stacks/src/filters/factories.ts",
				"line": 354
			},
			"overloads": [
				{
					"label": "",
					"description": "",
					"params": [
						{
							"name": "source",
							"type": "SubgraphSourceSpec",
							"required": true,
							"description": ""
						}
					],
					"returns": {
						"type": "ChainEventFilter<SubgraphMemberType>",
						"description": ""
					}
				}
			],
			"examples": []
		},
		{
			"id": "makeChainEventFilter",
			"path": "makeChainEventFilter",
			"summary": "Builds a canonical filter from a member type and its fields.",
			"description": "Builds a canonical filter from a member type and its fields.\n\nIt validates the spec and attaches the projections its member supports.\nMethods are attached per member at runtime, matching the type-level gating\nexactly. `const F` preserves field literals, so a `prints` or `abi`\ndeclaration keeps its exact type through `toSubgraphSource()`, which is what\nfeeds `defineSubgraph` narrowing.",
			"source": {
				"file": "packages/stacks/src/filters/factories.ts",
				"line": 322
			},
			"overloads": [
				{
					"label": "",
					"description": "",
					"typeParams": [
						{
							"name": "T",
							"constraint": "ChainEventFilterType"
						},
						{
							"name": "F",
							"constraint": "Omit<SpecFor<T>, \"type\">",
							"const": true
						}
					],
					"params": [
						{
							"name": "type",
							"type": "T",
							"required": true,
							"description": ""
						},
						{
							"name": "fields",
							"type": "F",
							"required": true,
							"description": ""
						}
					],
					"returns": {
						"type": "ChainEventFilter<T, { type: T } & F>",
						"description": ""
					}
				}
			],
			"examples": []
		},
