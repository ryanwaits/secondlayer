# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# API the server calls. Unset: http://localhost:3800, or
# https://api.secondlayer.tools when NODE_ENV=production.
# SECONDLAYER_API_URL=http://localhost:3800

# API the browser calls directly. Same defaults as SECONDLAYER_API_URL.
# Leave commented out rather than empty: an empty value is used as-is.
# NEXT_PUBLIC_SECONDLAYER_API_URL=http://localhost:3800

# Origin prefixed to marketing links (e.g. /signin). Unset: links stay relative.
# NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# Domain attribute on the sl_session cookie, to share it across subdomains.
# Unset: host-only cookie.
# SESSION_COOKIE_DOMAIN=.example.com
