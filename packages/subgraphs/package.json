{
	"name": "@secondlayer/subgraphs",
	"version": "4.4.1",
	"description": "Describe the Stacks data you want as one TypeScript file; it fills itself and survives reorgs.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ryanwaits/secondlayer.git",
		"directory": "packages/subgraphs"
	},
	"homepage": "https://github.com/ryanwaits/secondlayer/tree/main/packages/subgraphs#readme",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"import": "./dist/schema/index.js"
		},
		"./validate": {
			"types": "./dist/validate.d.ts",
			"import": "./dist/validate.js"
		},
		"./runtime/replay": {
			"types": "./dist/runtime/replay.d.ts",
			"import": "./dist/runtime/replay.js"
		},
		"./runtime/emitter": {
			"types": "./dist/runtime/emitter.d.ts",
			"import": "./dist/runtime/emitter.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@secondlayer/shared": "^11.7.1",
		"@secondlayer/stacks": "^6.1.0",
		"esbuild": "^0.28.2",
		"kysely": "0.28.17",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5"
	},
	"publishConfig": {
		"access": "public"
	}
}
