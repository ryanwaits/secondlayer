{
	"name": "@secondlayer/subgraphs",
	"version": "8.1.13",
	"description": "Describe the Stacks data you want as one TypeScript file; it fills itself and survives reorgs.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ryanwaits/secondlayer.git",
		"directory": "packages/subgraphs"
	},
	"homepage": "https://www.secondlayer.tools/docs/subgraphs",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"import": "./dist/schema/index.js"
		},
		"./validate": {
			"types": "./dist/validate.d.ts",
			"import": "./dist/validate.js"
		},
		"./verification": {
			"types": "./dist/verification.d.ts",
			"import": "./dist/verification.js"
		},
		"./runtime/replay": {
			"types": "./dist/runtime/replay.d.ts",
			"import": "./dist/runtime/replay.js"
		},
		"./runtime/emitter": {
			"types": "./dist/runtime/emitter.d.ts",
			"import": "./dist/runtime/emitter.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./verify": {
			"types": "./dist/verify/index.d.ts",
			"import": "./dist/verify/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "rm -rf dist && bunup",
		"dev": "bunup --watch",
		"test": "bun test",
		"typecheck": "bun check",
		"openpkg": "bun scripts/sync-openpkg.ts",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@secondlayer/shared": "^18.0.0",
		"@secondlayer/stacks": "^7.0.0",
		"@secondlayer/verify": "^0.6.4",
		"esbuild": "^0.28.2",
		"kysely": "0.28.17",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"bunup": "0.16.32",
		"typescript": "^5"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"stacks",
		"subgraph",
		"indexer",
		"postgres",
		"typescript",
		"clarity"
	]
}
