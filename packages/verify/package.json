{
	"name": "@secondlayer/verify",
	"version": "0.1.0",
	"description": "Check a Stacks block yourself: Bitcoin headers, signer signatures and MARF state proofs, from one trusted checkpoint.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ryanwaits/secondlayer.git",
		"directory": "packages/verify"
	},
	"homepage": "https://github.com/ryanwaits/secondlayer/tree/main/packages/verify#readme",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
