{
	"name": "@secondlayer/verify",
	"version": "0.6.1",
	"description": "Check a Stacks block yourself: Bitcoin headers, signer signatures and MARF state proofs, from one trusted checkpoint.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ryanwaits/secondlayer.git",
		"directory": "packages/verify"
	},
	"homepage": "https://www.secondlayer.tools/docs/verification",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"openpkg": "bun scripts/sync-openpkg.ts",
		"rotate-checkpoint": "bun scripts/rotate-checkpoint.ts",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@noble/curves": "2.0.1",
		"@noble/hashes": "2.0.1",
		"@secondlayer/stacks": "^6.5.3"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"stacks",
		"bitcoin",
		"merkle-proof",
		"marf",
		"verify",
		"light-client"
	]
}
