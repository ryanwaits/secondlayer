{
	"name": "@secondlayer/mcp",
	"version": "11.6.7",
	"description": "MCP server for Stacks chain data: contracts, events, transfers, subgraphs. Key-authenticated.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ryanwaits/secondlayer.git",
		"directory": "packages/mcp"
	},
	"homepage": "https://www.secondlayer.tools/docs/mcp",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"mcp": "./dist/bin.js",
		"secondlayer-mcp": "./dist/bin.js",
		"mcp-http": "./dist/bin-http.js",
		"secondlayer-mcp-http": "./dist/bin-http.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"test": "bun test",
		"tools": "bun scripts/sync-tools.ts && bun scripts/sync-server-json.ts",
		"typecheck": "bun check",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@secondlayer/bundler": "^0.7.3",
		"@secondlayer/scaffold": "^1.6.4",
		"@secondlayer/sdk": "^19.0.2",
		"@secondlayer/shared": "^18.0.0",
		"@secondlayer/stacks": "^7.0.0",
		"@secondlayer/subgraphs": "^8.1.12",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"stacks",
		"mcp",
		"mcp-server",
		"model-context-protocol",
		"bitcoin",
		"indexer"
	],
	"mcpName": "tools.secondlayer/secondlayer"
}
