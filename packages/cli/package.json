{
	"name": "@secondlayer/cli",
	"version": "12.2.0",
	"description": "Run a Stacks index on your own hardware — set it up, restore verified history, and keep it current.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ryanwaits/secondlayer.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/ryanwaits/secondlayer/tree/main/packages/cli#readme",
	"type": "module",
	"bin": {
		"secondlayer": "./dist/cli.js",
		"sl": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.ts",
			"import": "./dist/plugins/index.js"
		}
	},
	"files": ["dist", "templates", "README.md"],
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"keywords": ["stacks", "clarity", "blockchain", "smart-contracts", "cli"],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@biomejs/js-api": "^0.7.0",
		"@biomejs/wasm-nodejs": "^1.9.0",
		"@dsnp/parquetjs": "^1.8.8",
		"@inquirer/prompts": "^8.2.0",
		"@secondlayer/bundler": "^0.5.1",
		"@secondlayer/scaffold": "^1.5.4",
		"@secondlayer/sdk": "^8.0.1",
		"@secondlayer/shared": "^10.0.1",
		"@secondlayer/stacks": "^4.0.0",
		"@secondlayer/subgraphs": "^4.0.2",
		"esbuild": "^0.27.4",
		"smol-toml": "^1.6.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@antfu/ni": "^24.4.0",
		"@hirosystems/clarinet-sdk": "^3.0.2",
		"@tanstack/react-query": "^5.77.0",
		"@types/bun": "^1.1.14",
		"@types/react": "^19.1.5",
		"chalk": "^5.3.0",
		"commander": "^14.0.0",
		"execa": "^9.5.3",
		"fast-glob": "^3.3.3",
		"got": "^13.0.0",
		"react": "^19.1.0"
	}
}
